{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist/server"
  },
  "include": [
    "server/**/*",
    "src/types.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}